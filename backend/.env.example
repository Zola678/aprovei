# ===================================================
# APROVEI BACKEND - VARIÁVEIS DE AMBIENTE
# ===================================================

# URL da Base de Dados PostgreSQL (Neon, Render ou Railway)
# Exemplo Neon: postgresql://neondb_owner:npg_xxxx@ep-cool-fog-12345.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./aprovei.db

# Chave secreta JWT (Gere uma chave longa e aleatória para produção)
SECRET_KEY=aprovei_super_secret_jwt_key_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Chave de API do Google Gemini (para recursos de IA)
GEMINI_API_KEY=

# Origens permitidas para CORS (separe por vírgula ou use * para liberar tudo)
CORS_ALLOWED_ORIGINS=*

# Segredo de setup para promoção de administrador inicial
SETUP_SECRET=aprovei-setup-2026
